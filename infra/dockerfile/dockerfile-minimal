FROM docker.io/golang:1.27.1 as builder

# Install necessary dependencies
#RUN apk update && apk add --no-cache git

# Set up work directory
WORKDIR /src

# Copy go.mod only (go.sum will be regenerated)
COPY /src/go.mod .
RUN go get -u github.com/golang-jwt/jwt/v5@v5.3.1
RUN go mod tidy
RUN go mod download

# Copy the rest of the source code
COPY /src/. .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -o ./server/mqd-client .

# Última versão ESTÁVEL do Alpine, com versão fixa. Não usar "edge" (versão de
# desenvolvimento, sem suporte de segurança e sem base de CVE no Trivy) nem
# "latest" (muda sem aviso entre builds).
FROM docker.io/alpine:3.24.2

# Apply pending security patches and set up an unprivileged user
RUN apk upgrade --no-cache && adduser -D mqd_user

#WORKDIR /usr/
#COPY --from=builder /src/server .

#Copy the built binary and set up unprivileged user
COPY --from=builder /src/server /usr/server
COPY --from=builder --chown=mqd_user /src/server/mqd-client /usr/mqd-client

#Include default settings file
COPY --from=builder --chown=mqd_user /src/settings ./settings

# Switch to the unprivileged user
USER mqd_user

EXPOSE 8080
EXPOSE 8081

#CMD ./mqd-client
# Run the application
CMD ["/usr/mqd-client"]
