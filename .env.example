# QA local — mqd-client (ver QA_run.md). Variáveis lidas por
# src/crosscutting/configuration (sobrescrevem src/settings/settings.yml).

# Organização (transmissora) em que a instância está "instalada" — mesmo valor
# de exemplo usado em src/settings/settings.yml e tools/mqd-server-mock/README.md.
SERVER_ORG_ID=d7384bd0-842f-43c5-be02-9d2b2d5efc2c
APPLICATION_MODE=TRANSMITTER
ENVIRONMENT=DEV
LOGGING_LEVEL=DEBUG
API_PORT=:8080
ENABLE_HTTPS=FALSE

# Aponta pro mqd-server-mock (serviço do docker-compose.yml deste repo). O
# docker-compose.yml já força este valor dentro do container.
PROXY_URL=http://mqd-server-mock:8082

# Janela de envio do relatório pro servidor central, em minutos (1-60). Em QA
# local usamos o mínimo pra ver o POST /report chegar no mock rápido.
REPORT_EXECUTION_WINDOW=1

# Resultados locais (data_logs) desligados no QA — não é o foco do smoke test.
RESULT_ENABLED=FALSE
